# Database Configuration (Neon PostgreSQL or SQLite)
# If DATABASE_URL is left empty or not provided, the system defaults to local SQLite (users.db).
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.c-7.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.c-7.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH=production

# Application Environment: development | production
APP_ENV=development

# Optional: Custom Email Configuration Path
# EMAIL_CONFIG_PATH=email_config.json
